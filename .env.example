# Copy this file to .env and fill in real values. Never commit .env.

# Target Hospital Management System (must be a test/staging system you are
# authorized to test).
HMS_URL=https://staging.your-hospital-system.example.com
HMS_EMAIL=tester@example.com
HMS_PASSWORD=change-me

# Optional additional role credentials for role-based testing (Phase 3+).
# Format: JSON object of role -> {email, password}
# HMS_ROLE_CREDENTIALS={"doctor": {"email": "...", "password": "..."}, "nurse": {"email": "...", "password": "..."}}

# TEST | STAGING | PRODUCTION. Mutating/destructive tests are force-disabled
# unless this is TEST or STAGING.
HMS_ENVIRONMENT=TEST

# Local Ollama instance used for discovery interpretation, test generation,
# and bug analysis.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
